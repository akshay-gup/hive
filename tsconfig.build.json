{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rewriteRelativeImportExtensions": true,
    "outDir": "dist",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": [
    "apps/server/**/*.ts",
    "apps/control/**/*.ts",
    "apps/workspace/**/*.ts",
    "apps/edge/**/*.ts",
    "packages/**/*.ts"
  ],
  "exclude": ["node_modules", "tests", "apps/mobile", "apps/worker"]
}
