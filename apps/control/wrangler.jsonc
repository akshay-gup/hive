{
  // The control plane on Cloudflare (see src/worker.ts). Deploy from this directory: `wrangler deploy`.
  // Fill in database_id (from `wrangler d1 create hive-control`), then apply the schema with
  // `wrangler d1 migrations apply hive-control --remote`.
  // Secrets, set with `wrangler secret put`: CONTROL_SIGNING_KEY, GOOGLE_CLIENT_SECRET, and the
  // provider's (DO_API_TOKEN, or FLY_API_TOKEN), plus CLOUDFLARE_API_TOKEN for tunnels, and
  // HIVE_WORKSPACE_ENV if workspaces get a model key, or GATEWAY_PROVIDERS (a JSON object of the
  // providers and their keys) with the var GATEWAY_MODEL if the control plane keeps the key and
  // workspaces call it. DO_IMAGE and DO_REGIONS also go in vars.
  "name": "hive-control",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "api.vi-ak.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hive-control",
      "database_id": "f5d3bc86-8efd-4d2c-85ea-e15e5e46b731",
      "migrations_dir": "migrations"
    }
  ],
  "workflows": [
    { "name": "hive-provision", "binding": "PROVISION", "class_name": "ProvisionWorkspace" }
  ],
  "triggers": { "crons": ["* * * * *"] },
  "ratelimits": [
    { "name": "SIGNIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
    // Model requests per workspace, when the gateway is on (GATEWAY_PROVIDERS and GATEWAY_MODEL).
    { "name": "GATEWAY_LIMITER", "namespace_id": "1002", "simple": { "limit": 120, "period": 60 } }
  ],
  "vars": {
    "CONTROL_MODE": "live",
    "CONTROL_PUBLIC_URL": "https://api.vi-ak.com",
    "CONTROL_ALLOWED_ORIGINS": "https://app.vi-ak.com",
    // One workspace each, made or joined.
    "CONTROL_MAX_WORKSPACES": "1",
    "CONTROL_CLIENT_IP_HEADER": "CF-Connecting-IP",
    "GOOGLE_CLIENT_ID": "186881596007-ubstc9olcv2gevk71eit5q7fl77fl489.apps.googleusercontent.com",
    "PROVISIONER": "digitalocean",
    // Each workspace reached through a Cloudflare Tunnel of its own, with no edge to run. The
    // account id and the zone id are on the zone's overview page; the zone is the one the addresses are in.
    "DO_ACCESS": "tunnel",
    "DO_PUBLIC_URL_TEMPLATE": "https://ws-{id}.vi-ak.com",
    "CLOUDFLARE_ACCOUNT_ID": "c582e3d8cfe5ee494d65a4987c4ec102",
    "CLOUDFLARE_ZONE_ID": "8034fb3e2eb820737c9655df47f4781e",
    // Tried in this order; the image is copied to the later ones by the Worker (a minute after it starts).
    "DO_REGIONS": "nyc3,tor1,ric1",
    "DO_WAIT_SECONDS": "480",
    // DigitalOcean backs each workspace's Droplet up daily, in the window that starts at 08:00 UTC
    // (4 a.m. in New York), on its usage-based plan ($0.03 per GB of a backup's restorable size a
    // month, kept 7 days) and not the flat one (30% of the Droplet's price). A Droplet is made on
    // the flat plan and switched; if that is refused it keeps the flat one and the log says so.
    "DO_BACKUPS": "custom_daily",
    "DO_BACKUP_HOUR": "8",
    "DO_IMAGE": "250943924",
    // The model every new workspace runs on, through the gateway; the provider's key is the secret GATEWAY_PROVIDERS.
    "GATEWAY_MODEL": "fireworks-ai/accounts/fireworks/models/deepseek-v4p1-flash-1017",
    // This one is newer than the agent's own list, so it is described to it: it reasons, calls tools,
    // and wants its reasoning sent back with each tool call (as the model it was made from does).
    "GATEWAY_MODEL_CONFIG": "{\"name\":\"DeepSeek V4.1 Flash 1017\",\"reasoning\":true,\"tool_call\":true,\"attachment\":true,\"temperature\":true,\"interleaved\":{\"field\":\"reasoning_content\"},\"limit\":{\"context\":1000000,\"output\":384000}}"
  }
}
