{
  // The same Worker as wrangler.jsonc, for trying it on Cloudflare before it is anyone's: no custom
  // domain (it answers at its workers.dev address), a bucket of its own, and a key pair made for the test.
  "name": "hive-chat-staging",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "ChatRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  // Add "r2_buckets": [{ "binding": "FILES", "bucket_name": "hive-chat-files-staging" }] once the account has R2.
  "vars": {
    "CHAT_ALLOWED_ORIGINS": "https://app.vi-ak.com,http://localhost:8081",
    "CONTROL_PUBLIC_KEY": "MCowBQYDK2VwAyEAKpt6ENIof6vxwpC4eW8-WP64GpGdYCWLRRJFlbd_j-A"
  }
}
