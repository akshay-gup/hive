{
  "name": "hive-chat",
  "main": "src/worker.ts",
  "compatibility_date": "2025-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "chat.vi-ak.com", "custom_domain": true }],
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "ChatRoom" }]
  },
  // Cloudflare's declaration of the room class (what the object is called and that it uses SQLite),
  // not a data migration. The class is never renamed once it is deployed.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }],
  // People's files, under w/<workspace>/. Make it once: `wrangler r2 bucket create hive-chat-files`.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "hive-chat-files" }],
  "ratelimits": [
    { "name": "CHAT_LIMITER", "namespace_id": "1003", "simple": { "limit": 600, "period": 60 } }
  ],
  "vars": {
    "CHAT_ALLOWED_ORIGINS": "https://app.vi-ak.com",
    // The control plane's public key (not a secret): set it to the value of CONTROL_PUBLIC_KEY the
    // workspaces are given, which `wrangler secret put` or an edit here provides before the first deploy.
    "CONTROL_PUBLIC_KEY": "MCowBQYDK2VwAyEAqLyFMTSo3eOIi87n7Zw7yEzxauvxbtq1qex0i8nSKko",
    // Where the control plane is: the room asks it to start the agent's machine when the agent is mentioned.
    "CONTROL_URL": "https://api.vi-ak.com"
    // Also set, as secrets: FILE_LINK_KEY, what the addresses for sending and fetching files are signed with
    // (`wrangler secret put FILE_LINK_KEY`), and CHAT_WAKE_KEY, which proves to the control plane that the
    // request to start a machine is the chat service's (the same value is the control plane's CHAT_WAKE_KEY).
  }
}
