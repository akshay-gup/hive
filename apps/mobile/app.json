{
  "expo": {
    "name": "Hive",
    "slug": "hive",
    "scheme": "hive",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.hive.mobile" },
    "android": { "package": "app.hive.mobile" },
    "web": { "bundler": "metro", "name": "Hive — a little room for everything" },
    "plugins": [
      "expo-document-picker",
      "@config-plugins/react-native-blob-util",
      "@config-plugins/react-native-pdf"
    ]
  }
}
