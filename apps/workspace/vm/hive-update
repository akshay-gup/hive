#!/usr/bin/env bash
# Puts a newer build of the workspace on this machine, in place, and goes back if it does not come up.
#
# What changes is the program: /app, and node and opencode beside it. What does not is anything the
# workspace or the agent keeps: /data, /home/hive, /etc/hive. The build comes from the same container
# image the snapshot was baked from, read with `crane` (no Docker on the machine), by digest when it
# is given one, so what is fetched is exactly what was asked for.
#
#   hive-update                 asks the control plane which build this workspace should run, and
#                               does nothing if it is running it. This is what the timer runs.
#   hive-update --to TAG        puts that tag on now (for an operator on the machine).
#   hive-update --to TAG --digest sha256:...   the same, checked against the image's digest.
#   hive-update --force         does not wait for the workspace to be idle.
#
# Besides the build, it keeps the workspace's settings (/etc/hive/workspace.json, which the workspace is
# made with) as the control plane wants them. The answer carries a short revision of what to change in
# them; when it is not the one this machine is on, the machine fetches the change with its own key
# (never without it: it can include that key), puts it over the settings the machine was made with
# (kept as workspace.base.json, so a change taken away puts the setting back), and restarts the
# workspace on them, going back if it does not come up. The identity settings are never changed.
# What it does not understand (a newer kind of change) it leaves alone and says so, and a build that
# carries a newer updater is how it learns.
#
# Settings, if the machine is to ask on its own, are in /etc/hive/updater.json:
#   {"repo": "ghcr.io/OWNER/hive-workspace", "wantedUrl": "https://...", "tokenFile": "/etc/hive/update-token"}
# `wantedUrl` answers {"tag": "...", "digest": "sha256:...", "force": false}. Without the file the timer
# does nothing, so a machine is only updated once it has been told where to ask.
#
# The updater is part of the build. After fetching, it looks for a newer copy of itself in the image
# (app/machine/hive-update), tries that copy with --self-test, and only if it passes installs it and
# carries on with the update as that copy. The copy that last finished an update is kept as
# hive-update.good, and hive-update-fallback runs it if the current one fails (see that script).
# The image also brings app/machine/hive-ensure, which makes the machine what the build needs
# (packages, Chromium) before anything is stopped; it is safe to run again and only adds.
#
# Everything with a path or a command is a variable, so the tests run it on a folder and not a machine.
set -euo pipefail
umask 022

APP=${HIVE_APP:-/app}
SELF=${HIVE_SELF:-/usr/local/sbin/hive-update}
BIN=${HIVE_BIN:-/usr/local/bin}
ETC=${HIVE_ETC:-/etc/hive}
STATE=${HIVE_STATE:-/var/lib/hive}
SYSTEMCTL=${HIVE_SYSTEMCTL:-systemctl}
CRANE=${HIVE_CRANE:-crane}
HEALTH=${HIVE_HEALTH:-http://127.0.0.1:8787/api/health}
SERVICE=${HIVE_SERVICE:-hive-workspace.service}
IDLE_CHECK=${HIVE_IDLE_CHECK:-$ETC/idle-check}
HEALTH_WAIT=${HIVE_HEALTH_WAIT:-60}
IDLE_WAIT=${HIVE_IDLE_WAIT:-1800}
MIN_FREE_MB=${HIVE_MIN_FREE_MB:-3072}

# What it says goes to the journal and to a file the workspace's health answer can show, since nobody
# can log in to read the journal. The file keeps its last 200 lines.
say() {
  local line
  line=$(printf '%s hive-update: %s' "$(date -u +%FT%TZ)" "$*")
  printf '%s\n' "$line"
  printf '%s\n' "$line" >>"$STATE/update.log" 2>/dev/null || true
}
fail() { say "$*" >&2; exit 1; }

if [ -f "$STATE/update.log" ] && [ "$(wc -l <"$STATE/update.log")" -gt 200 ]; then
  tail -n 200 "$STATE/update.log" >"$STATE/update.log.new" && mv "$STATE/update.log.new" "$STATE/update.log" || true
fi

want_tag= want_digest= force= answer=
while [ $# -gt 0 ]; do
  case "$1" in
    --self-test) echo ok; exit 0 ;;
    --to) want_tag=${2:?--to needs a tag}; shift 2 ;;
    --digest) want_digest=${2:?--digest needs a digest}; shift 2 ;;
    --force) force=1; shift ;;
    *) fail "Unknown argument $1" ;;
  esac
done

mkdir -p "$STATE"
# A copy of itself that this one started has been handed the lock already.
if [ -z "${HIVE_PRESTAGED:-}" ]; then
  exec 9>"$STATE/update.lock"
  flock -n 9 || { say "another update is running"; exit 0; }
fi

record() { # state, version, message
  printf '{"state":"%s","version":"%s","message":"%s","at":"%s"}\n' \
    "$1" "$2" "${3//\"/\'}" "$(date -u +%FT%TZ)" >"$STATE/last-update.json"
}

current() { [ -f "$APP/VERSION" ] && tr -d '[:space:]' <"$APP/VERSION" || echo unknown; }

settings() { [ -f "$ETC/updater.json" ] && jq -r "$1 // empty" "$ETC/updater.json" 2>/dev/null || true; }

repo=${HIVE_IMAGE_REPO:-$(settings .repo)}
if [ -z "$repo" ] && [ -f "$ETC/image.json" ]; then
  # The image the snapshot was baked from, as "ghcr.io/owner/name@sha256:..." or with a tag.
  repo=$(jq -r '.image // empty' "$ETC/image.json" | sed -E 's/[@:][^/@:]*$//; s/@.*$//')
fi

# Waits until the workspace is idle, so a restart does not cut off the agent. The check is a command an
# operator provides (exit 0 means idle); there is none by default, and --force skips it. Fails if it
# is still busy after IDLE_WAIT.
wait_idle() {
  { [ -z "$force" ] && [ -x "$IDLE_CHECK" ]; } || return 0
  local waited=0
  until "$IDLE_CHECK"; do
    [ "$waited" -lt "$IDLE_WAIT" ] || return 1
    sleep 30
    waited=$((waited + 30))
  done
}

record_config() { # state, revision, message
  printf '{"state":"%s","rev":"%s","message":"%s","at":"%s"}\n' \
    "$1" "$2" "${3//\"/\'}" "$(date -u +%FT%TZ)" >"$STATE/last-config.json"
}

# The settings the control plane wants this workspace to have (see the top). It runs with the update
# lock held and the answer to the control plane's question in $answer; a machine with no answer, or
# an old control plane that gives none, leaves the settings as they are.
PROTECTED='["WORKSPACE_ID","CONTROL_PLANE_PUBLIC_KEY","WORKSPACE_MODE","HOST","PORT","DATA_DIR"]'
reconcile_config() {
  [ -n "$answer" ] || return 0
  local rev v applied live base url token tokenFile doc desired prev have up i
  rev=$(jq -r '.config.rev // empty' <<<"$answer" 2>/dev/null || true)
  [ -n "$rev" ] || return 0
  v=$(jq -r '.config.v // empty' <<<"$answer" 2>/dev/null || true)
  if [ "$v" != 1 ]; then
    say "settings come in a form (version $v) this updater does not know; a newer build will"
    return 0
  fi
  [[ "$rev" =~ ^[0-9a-f]{8,64}$ ]] || return 0
  applied=$(cat "$STATE/config.rev" 2>/dev/null || true)
  [ "$applied" != "$rev" ] || return 0
  # One that already failed here is not tried again until the control plane says something else.
  [ "$(cat "$STATE/config.failed" 2>/dev/null || true)" != "$rev" ] || return 0

  live=$ETC/workspace.json
  base=$ETC/workspace.base.json
  [ -f "$live" ] || return 0
  [ -f "$base" ] || install -m 0600 "$live" "$base"

  url=$(settings .wantedUrl)
  [ -n "$url" ] || return 0
  # The workspace's own key: from a file if the machine was given one, else the one it reaches the
  # model gateway with, which the control plane made for it and nobody else has.
  tokenFile=$(settings .tokenFile)
  token=
  [ -n "$tokenFile" ] && [ -r "$tokenFile" ] && token=$(tr -d '[:space:]' <"$tokenFile")
  [ -n "$token" ] || token=$(jq -r '[.OPENCODE_CONFIG_CONTENT // empty | fromjson | .provider[]?.options.apiKey // empty] | first // empty' "$base" 2>/dev/null || true)
  [ -n "$token" ] || { say "settings changed ($rev) but this machine has no key to ask for them with"; return 0; }
  doc=$(curl -fsS --max-time 20 -H "Authorization: Bearer $token" "$url/config") ||
    { say "could not ask for settings $rev"; return 0; }
  if ! jq -e --arg rev "$rev" '
      .v == 1 and .rev == $rev and (.env | type == "object")
      and ([.env[] | (type == "string" or . == null)] | all)
      and ([.env | keys[] | test("^[A-Z][A-Z0-9_]{0,63}$")] | all)' <<<"$doc" >/dev/null 2>&1; then
    say "the settings it was given ($rev) are not in a form this updater accepts, or have moved on; leaving them"
    return 0
  fi
  desired=$(jq -S --argjson patch "$(jq -c .env <<<"$doc")" --argjson keep "$PROTECTED" '
      reduce ($patch | to_entries[] | select(.key | IN($keep[]) | not)) as $e (.;
        if $e.value == null then del(.[$e.key]) else .[$e.key] = $e.value end)' "$base") ||
    { say "could not work out the settings for $rev"; return 0; }
  jq -e 'type == "object" and ([.[] | type == "string"] | all)' <<<"$desired" >/dev/null 2>&1 ||
    { say "settings $rev would not be an object of strings; leaving them"; return 0; }

  if [ "$(jq -S . "$live")" = "$desired" ]; then
    printf '%s' "$rev" >"$STATE/config.rev"
    say "settings are already as $rev"
    return 0
  fi
  say "settings ${applied:-as made} -> $rev"
  wait_idle || { record_config waiting "$rev" "busy; will try again"; say "still busy, will change settings later"; return 0; }

  prev=$live.prev
  cp -p "$live" "$prev"
  printf '%s\n' "$desired" >"$live.new"
  chmod 0600 "$live.new"
  mv "$live.new" "$live"
  record_config applying "$rev" "restarting on the new settings"
  "$SYSTEMCTL" restart "$SERVICE" || true
  have=$(current)
  up=
  for ((i = 0; i < HEALTH_WAIT; i += 2)); do
    if [ "$(curl -fsS --max-time 3 "$HEALTH" 2>/dev/null | jq -r '.version // empty')" = "$have" ]; then up=1; break; fi
    sleep 2
  done
  if [ -z "$up" ]; then
    say "did not come up on settings $rev, going back"
    mv "$prev" "$live"
    "$SYSTEMCTL" restart "$SERVICE" || true
    printf '%s' "$rev" >"$STATE/config.failed"
    record_config failed "$rev" "did not come up; went back to the settings it had"
    return 0
  fi
  printf '%s' "$rev" >"$STATE/config.rev"
  rm -f "$STATE/config.failed"
  record_config updated "$rev" "from ${applied:-as made}"
  say "settings are now $rev"
}

# An "update now" from the workspace server is a file it drops here (it holds "force" to skip the wait).
if [ -f "$STATE/update-request" ]; then
  grep -q force "$STATE/update-request" && force=1
  rm -f "$STATE/update-request"
fi

if [ -z "$want_tag" ]; then
  url=$(settings .wantedUrl)
  [ -n "$url" ] || exit 0 # not told where to ask
  tokenFile=$(settings .tokenFile)
  auth=()
  [ -n "$tokenFile" ] && [ -r "$tokenFile" ] && auth=(-H "Authorization: Bearer $(tr -d '[:space:]' <"$tokenFile")")
  answer=$(curl -fsS --max-time 20 "${auth[@]}" "$url") || { say "could not ask $url"; exit 0; }
  want_tag=$(jq -r '.tag // empty' <<<"$answer")
  want_digest=$(jq -r '.digest // empty' <<<"$answer")
  [ "$(jq -r '.force // false' <<<"$answer")" = true ] && force=1
fi

[ -n "$want_tag" ] || { reconcile_config; exit 0; }
[[ "$want_tag" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]{0,127}$ ]] || fail "Not a usable tag: $want_tag"
[ -z "$want_digest" ] || [[ "$want_digest" =~ ^sha256:[0-9a-f]{64}$ ]] || fail "Not a usable digest: $want_digest"
[ -n "$repo" ] || fail "No image repository: set it in $ETC/updater.json"

have=$(current)
if [ "$have" = "$want_tag" ]; then
  say "already on $have"
  reconcile_config
  exit 0
fi
say "$have -> $want_tag"

# Wait until the workspace is idle, so a restart does not cut off the agent.
wait_idle || { record waiting "$have" "busy; will try again"; say "still busy, will try again"; exit 0; }

free_mb=$(df -Pm "$(dirname "$APP")" | awk 'NR==2 {print $4}')
[ "${free_mb:-0}" -ge "$MIN_FREE_MB" ] || { record failed "$have" "only ${free_mb}MB free"; fail "only ${free_mb}MB free, need $MIN_FREE_MB"; }

ref="$repo:$want_tag"
if [ -n "$want_digest" ]; then
  ref="$repo@$want_digest"
  # A tag can be moved; the digest says exactly which build, and the tag is checked against it.
  [ "$("$CRANE" digest "$repo:$want_tag")" = "$want_digest" ] ||
    { record failed "$have" "$want_tag is not $want_digest"; fail "$repo:$want_tag is not $want_digest"; }
fi

NEXT="$APP.next" PREV="$APP.prev"
if [ -n "${HIVE_PRESTAGED:-}" ]; then
  STAGE=$HIVE_PRESTAGED # fetched by the updater that handed over to this one
else
  STAGE=$(mktemp -d "$STATE/stage.XXXXXX")
fi
trap 'rm -rf "$STAGE"' EXIT
if [ -z "${HIVE_PRESTAGED:-}" ]; then
  record fetching "$have" "$want_tag"
  say "fetching $ref"
  "$CRANE" export "$ref" - | tar -x -C "$STAGE" app usr/local/bin/node usr/local/bin/opencode ||
    { record failed "$have" "could not fetch $ref"; fail "could not fetch $ref"; }
  [ -f "$STAGE/app/package.json" ] && [ -x "$STAGE/usr/local/bin/node" ] && [ -x "$STAGE/usr/local/bin/opencode" ] ||
    { record failed "$have" "$ref is not a workspace build"; fail "$ref is not a workspace build"; }
  # Builds made before VERSION existed carry none; say which one this is.
  printf '%s\n' "$want_tag" >"$STAGE/app/VERSION"

  # Take the build's own updater, if it has one that differs and works, and carry on as that.
  new="$STAGE/app/machine/hive-update"
  if [ -z "${HIVE_NO_SELF_UPDATE:-}" ] && [ -f "$new" ] && ! cmp -s "$new" "$SELF"; then
    if bash -n "$new" && [ "$(bash "$new" --self-test 2>/dev/null)" = ok ]; then
      say "taking the updater that came with $want_tag"
      install -m 0755 "$new" "$SELF.new"
      mv "$SELF.new" "$SELF"
      args=(--to "$want_tag" --force)
      [ -z "$want_digest" ] || args+=(--digest "$want_digest")
      trap - EXIT # the copy that takes over cleans up
      HIVE_PRESTAGED=$STAGE exec bash "$SELF" "${args[@]}"
    fi
    say "the updater that came with $want_tag does not pass its own test; keeping this one"
  fi
fi

# Make the machine what the build needs, while the workspace is still running on the old build. If this
# fails nothing has been changed yet.
ensure="$STAGE/app/machine/hive-ensure"
if [ -f "$ensure" ]; then
  say "making the machine ready for $want_tag"
  HIVE_APP="$STAGE/app" HIVE_NODE="$STAGE/usr/local/bin/node" HIVE_STATE="$STATE" bash "$ensure" ||
    { record failed "$have" "could not make the machine ready for $want_tag"; fail "could not make the machine ready for $want_tag"; }
fi

# Swap. The old program and binaries are kept until the next update succeeds.
record switching "$have" "$want_tag"
rm -rf "$NEXT" "$PREV"
mv "$STAGE/app" "$NEXT"
"$SYSTEMCTL" stop "$SERVICE"
mv "$APP" "$PREV"
mv "$NEXT" "$APP"
for b in node opencode; do
  [ -e "$BIN/$b" ] && cp -a "$BIN/$b" "$STATE/$b.prev"
  install -m 0755 "$STAGE/usr/local/bin/$b" "$BIN/$b"
done
"$SYSTEMCTL" start "$SERVICE"

# It is the new build only once it says so.
up=
for ((i = 0; i < HEALTH_WAIT; i += 2)); do
  if [ "$(curl -fsS --max-time 3 "$HEALTH" 2>/dev/null | jq -r '.version // empty')" = "$want_tag" ]; then up=1; break; fi
  sleep 2
done

if [ -z "$up" ]; then
  say "$want_tag did not come up, going back to $have"
  "$SYSTEMCTL" stop "$SERVICE" || true
  rm -rf "$APP"
  mv "$PREV" "$APP"
  for b in node opencode; do [ -e "$STATE/$b.prev" ] && install -m 0755 "$STATE/$b.prev" "$BIN/$b"; done
  "$SYSTEMCTL" start "$SERVICE" || true
  record failed "$have" "$want_tag did not come up; went back to $have"
  exit 1
fi

rm -f "$STATE/node.prev" "$STATE/opencode.prev"
# The copy that ran this update has now finished one, so it is the one to go back to if a later one fails.
this=$(readlink -f "$0")
[ "$this" = "$(readlink -f "$SELF.good" 2>/dev/null || true)" ] || cp -p "$this" "$SELF.good"
record updated "$want_tag" "from $have"
say "now on $want_tag"
reconcile_config
