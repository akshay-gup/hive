{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM"]
  },
  "include": [
    "apps/server/**/*.ts",
    "apps/control/**/*.ts",
    "apps/workspace/**/*.ts",
    "apps/edge/**/*.ts",
    "packages/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": ["node_modules", "apps/mobile", "apps/worker"]
}
